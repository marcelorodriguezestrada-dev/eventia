# Firebase — Project Settings → General → Tus apps → SDK setup and configuration
NEXT_PUBLIC_FIREBASE_API_KEY=tu-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=tu-proyecto
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=tu-proyecto.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef123456

# Groq — para el generador de cronogramas con IA (console.groq.com/keys)
# OJO: sin prefijo NEXT_PUBLIC_, esta key nunca debe llegar al navegador
GROQ_API_KEY=tu-groq-api-key

# Google Places — para el buscador de lugares/proveedores
# Conseguila en console.cloud.google.com → habilitar "Places API" → Credenciales
# OJO: sin prefijo NEXT_PUBLIC_, esta key nunca debe llegar al navegador
GOOGLE_PLACES_API_KEY=tu-google-places-api-key
